<UserControl x:Class="VisionMotionAlignment.Pages.DiagnosticPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0"
                   Text="诊断调试"
                   Style="{StaticResource PageTitleTextBlock}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 轴状态监控 -->
                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="轴状态监控" Style="{StaticResource SectionTitleTextBlock}" />
                        <TextBlock Text="实时显示运动控制卡各轴位置/速度/状态（由控制卡周期性推送）"
                                   FontSize="12" Opacity="0.6" Margin="0,2,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- X 轴标题 -->
                            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="X 轴" FontWeight="SemiBold" FontSize="14" />
                                    <Ellipse Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource StatusOfflineBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AxisXStatus}" Value="Moving">
                                                        <Setter Property="Fill" Value="{DynamicResource StatusNormalBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AxisXStatus}" Value="Homing">
                                                        <Setter Property="Fill" Value="{DynamicResource StatusCautionBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AxisXAlarm}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource StatusErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </StackPanel>
                            </Border>

                            <!-- Y 轴标题 -->
                            <Border Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="3"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Y 轴" FontWeight="SemiBold" FontSize="14" />
                                    <Ellipse Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource StatusOfflineBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AxisYStatus}" Value="Moving">
                                                        <Setter Property="Fill" Value="{DynamicResource StatusNormalBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AxisYStatus}" Value="Homing">
                                                        <Setter Property="Fill" Value="{DynamicResource StatusCautionBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AxisYAlarm}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource StatusErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </StackPanel>
                            </Border>

                            <!-- X 轴位置 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="位置" VerticalAlignment="Center" Opacity="0.7" />
                            <TextBox Grid.Row="1" Grid.Column="2"
                                     Text="{Binding AxisXPos, StringFormat=F3, Mode=OneWay}"
                                     IsReadOnly="True" FontFamily="Consolas" Margin="0,2" />

                            <!-- Y 轴位置 -->
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="位置" VerticalAlignment="Center" Opacity="0.7" />
                            <TextBox Grid.Row="1" Grid.Column="6"
                                     Text="{Binding AxisYPos, StringFormat=F3, Mode=OneWay}"
                                     IsReadOnly="True" FontFamily="Consolas" Margin="0,2" />

                            <!-- X 轴速度 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="速度" VerticalAlignment="Center" Opacity="0.7" />
                            <TextBox Grid.Row="2" Grid.Column="2"
                                     Text="{Binding AxisXVel, StringFormat=F1, Mode=OneWay}"
                                     IsReadOnly="True" FontFamily="Consolas" Margin="0,2" />

                            <!-- Y 轴速度 -->
                            <TextBlock Grid.Row="2" Grid.Column="4" Text="速度" VerticalAlignment="Center" Opacity="0.7" />
                            <TextBox Grid.Row="2" Grid.Column="6"
                                     Text="{Binding AxisYVel, StringFormat=F1, Mode=OneWay}"
                                     IsReadOnly="True" FontFamily="Consolas" Margin="0,2" />

                            <!-- X 轴状态 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="状态" VerticalAlignment="Center" Opacity="0.7" />
                            <TextBox Grid.Row="3" Grid.Column="2"
                                     Text="{Binding AxisXStatus, Mode=OneWay}"
                                     IsReadOnly="True" FontFamily="Consolas" Margin="0,2" />

                            <!-- Y 轴状态 -->
                            <TextBlock Grid.Row="3" Grid.Column="4" Text="状态" VerticalAlignment="Center" Opacity="0.7" />
                            <TextBox Grid.Row="3" Grid.Column="6"
                                     Text="{Binding AxisYStatus, Mode=OneWay}"
                                     IsReadOnly="True" FontFamily="Consolas" Margin="0,2" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 读保持寄存器 -->
                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="读保持寄存器" Style="{StaticResource SectionTitleTextBlock}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="从站地址" Style="{DynamicResource SectionTitleTextBlock}" Margin="0,0,0,2" />
                                <ui:NumberBox Value="{Binding ModbusSlaveAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="0"
                                              Maximum="255" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="起始地址" Style="{DynamicResource SectionTitleTextBlock}" Margin="0,0,0,2" />
                                <ui:NumberBox Value="{Binding ModbusStartAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="0" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="数量" Style="{DynamicResource SectionTitleTextBlock}" Margin="0,0,0,2" />
                                <ui:NumberBox Value="{Binding ModbusQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="1" />
                            </StackPanel>
                            <ui:Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                                       Content="读取"
                                       Command="{Binding ReadRegistersCommand}"
                                       Appearance="Primary"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,8,0,0" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 写单个寄存器 -->
                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="写单个寄存器" Style="{StaticResource SectionTitleTextBlock}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="地址" Style="{DynamicResource SectionTitleTextBlock}" Margin="0,0,0,2" />
                                <ui:NumberBox Value="{Binding WriteAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="0" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="值" Style="{DynamicResource SectionTitleTextBlock}" Margin="0,0,0,2" />
                                <ui:NumberBox Value="{Binding WriteValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="0" />
                            </StackPanel>
                            <ui:Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                       Content="写入"
                                       Command="{Binding WriteRegisterCommand}"
                                       Appearance="Primary"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,8,0,0" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 结果显示 -->
                <ui:Card>
                    <StackPanel>
                        <TextBlock Text="结果" Style="{StaticResource SectionTitleTextBlock}" />
                        <TextBox Text="{Binding ModbusResult, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="120"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Cascadia Mono, Courier New" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

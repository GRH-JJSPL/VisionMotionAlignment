<UserControl x:Class="VisionMotionAlignment.Pages.CommSettingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:VisionMotionAlignment.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:m="clr-namespace:VisionMotionAlignment.Models">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="FloatByteOrderValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="m:FloatByteOrder" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0"
                   Text="通讯参数配置"
                   Style="{StaticResource PageTitleTextBlock}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 运动控制卡通讯卡片（TCP） -->
                <ui:Card>
                    <StackPanel>
                        <TextBlock Text="运动控制卡通讯" Style="{StaticResource SectionTitleTextBlock}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- IP 地址 -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="IP 地址："
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8" />
                            <ui:TextBox Grid.Row="0" Grid.Column="1"
                                        Text="{Binding MotionCardIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,8" />
                            <!-- 端口 -->
                            <TextBlock Grid.Row="0" Grid.Column="3"
                                       Text="端口："
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8" />
                            <ui:NumberBox Grid.Row="0" Grid.Column="4"
                                          Value="{Binding MotionCardPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Minimum="1"
                                          Maximum="65535"
                                          Margin="0,0,0,8" />
                            <!-- 连接状态 -->
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="连接状态："
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8" />
                            <views:StatusBadge Grid.Row="1" Grid.Column="1"
                                               DataContext="{Binding MotionCardConnectionState}"
                                               Margin="0,0,0,8" />
                            <!-- 连接 / 断开按钮 -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Stretch">
                                <ui:Button Content="连接"
                                           Command="{Binding ConnectMotionCardCommand}"
                                           Appearance="Primary"
                                           HorizontalAlignment="Stretch"
                                           Margin="0,0,8,0" />
                                <ui:Button Content="断开"
                                           Command="{Binding DisconnectMotionCardCommand}"
                                           HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 力值模块通讯卡片 -->
                <ui:Card>
                    <StackPanel>
                        <TextBlock Text="力值模块通讯" Style="{StaticResource SectionTitleTextBlock}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 串口名 -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="串口名："
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8" />
                            <ui:TextBox Grid.Row="0" Grid.Column="1"
                                        Text="{Binding ForcePortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,8" />
                            <!-- 波特率 -->
                            <TextBlock Grid.Row="0" Grid.Column="3"
                                       Text="波特率："
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8" />
                            <ui:NumberBox Grid.Row="0" Grid.Column="4"
                                          Value="{Binding ForceBaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Minimum="0"
                                          Margin="0,0,0,8" />
                            <!-- 从站地址 -->
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="从站地址："
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8" />
                            <ui:NumberBox Grid.Row="1" Grid.Column="1"
                                          Value="{Binding ForceSlaveAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Minimum="0"
                                          Maximum="255"
                                          Margin="0,0,0,8" />
                            <!-- 浮点数字节序 -->
                            <TextBlock Grid.Row="1" Grid.Column="3"
                                       Text="字节序："
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8" />
                            <ComboBox Grid.Row="1" Grid.Column="4"
                                      ItemsSource="{Binding Source={StaticResource FloatByteOrderValues}}"
                                      SelectedItem="{Binding ForceFloatByteOrder, Mode=TwoWay}"
                                      Margin="0,0,0,8" />
                            <!-- 连接状态 -->
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="连接状态："
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8" />
                            <views:StatusBadge Grid.Row="2" Grid.Column="1"
                                               DataContext="{Binding ForceConnectionState}"
                                               Margin="0,0,0,8" />
                            <!-- 连接按钮 -->
                            <ui:Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                                       Content="连接"
                                       Command="{Binding ConnectForceCommand}"
                                       Appearance="Primary"
                                       HorizontalAlignment="Stretch" />
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

<UserControl x:Class="VisionMotionAlignment.Pages.CameraSettingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0"
                   Text="相机参数配置"
                   Style="{StaticResource PageTitleTextBlock}" />

        <!-- 参数分区卡片 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 工位 1 设备 -->
                <ui:Card>
                    <StackPanel>
                        <TextBlock Text="工位 1 设备" Style="{StaticResource SectionTitleTextBlock}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="设备 Key："
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding Workstation1DeviceKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="请输入或选择设备" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 工位 2 设备 -->
                <ui:Card>
                    <StackPanel>
                        <TextBlock Text="工位 2 设备" Style="{StaticResource SectionTitleTextBlock}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="设备 Key："
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding Workstation2DeviceKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="请输入或选择设备" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 通用参数 -->
                <ui:Card>
                    <StackPanel>
                        <TextBlock Text="通用参数" Style="{StaticResource SectionTitleTextBlock}" />
                        <TextBlock Text="曝光时间 (μs)" Style="{DynamicResource SectionTitleTextBlock}" Margin="0,8,0,2" />
                        <ui:NumberBox Value="{Binding ExposureUs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Minimum="0" />
                        <TextBlock Text="增益 (dB)" Style="{DynamicResource SectionTitleTextBlock}" Margin="0,8,0,2" />
                        <ui:NumberBox Value="{Binding Gain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Minimum="0"
                                      Margin="0,8,0,0" />
                        <TextBlock Text="帧率 (fps)" Style="{DynamicResource SectionTitleTextBlock}" Margin="0,8,0,2" />
                        <ui:NumberBox Value="{Binding FrameRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Minimum="0"
                                      Margin="0,8,0,0" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮区 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="刷新设备"
                       Command="{Binding RefreshDevicesCommand}"
                       Margin="0,0,8,0" />
            <ui:Button Content="应用"
                       Command="{Binding ApplyCommand}"
                       Appearance="Primary" />
        </StackPanel>
    </Grid>
</UserControl>

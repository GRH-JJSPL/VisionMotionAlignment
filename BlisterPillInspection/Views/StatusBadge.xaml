<UserControl x:Class="BlisterPillInspection.Views.StatusBadge"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="28" d:DesignWidth="80">
    <UserControl.Resources>
        <!-- 状态徽章边框样式：根据 State（ConnectionState）切换背景色 -->
        <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource StatusOfflineBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <!-- 已连接 → 绿 -->
                <DataTrigger Binding="{Binding State, ElementName=root}" Value="Connected">
                    <Setter Property="Background" Value="{DynamicResource StatusNormalBrush}" />
                </DataTrigger>
                <!-- 连接中 → 黄 -->
                <DataTrigger Binding="{Binding State, ElementName=root}" Value="Connecting">
                    <Setter Property="Background" Value="{DynamicResource StatusWarningBrush}" />
                </DataTrigger>
                <!-- 重连中 → 黄 -->
                <DataTrigger Binding="{Binding State, ElementName=root}" Value="Reconnecting">
                    <Setter Property="Background" Value="{DynamicResource StatusWarningBrush}" />
                </DataTrigger>
                <!-- 已断开 → 灰 -->
                <DataTrigger Binding="{Binding State, ElementName=root}" Value="Disconnected">
                    <Setter Property="Background" Value="{DynamicResource StatusOfflineBrush}" />
                </DataTrigger>
                <!-- 失败 → 红 -->
                <DataTrigger Binding="{Binding State, ElementName=root}" Value="Failed">
                    <Setter Property="Background" Value="{DynamicResource StatusAlarmBrush}" />
                </DataTrigger>
                <!-- 未连接 → 灰 -->
                <DataTrigger Binding="{Binding State, ElementName=root}" Value="Idle">
                    <Setter Property="Background" Value="{DynamicResource StatusOfflineBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource StatusBadgeBorderStyle}">
        <!-- 文本同样用 DataTrigger 切换，避免引入额外 Converter -->
        <TextBlock VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Text" Value="未连接" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State, ElementName=root}" Value="Connected">
                            <Setter Property="Text" Value="已连接" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State, ElementName=root}" Value="Connecting">
                            <Setter Property="Text" Value="连接中" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State, ElementName=root}" Value="Reconnecting">
                            <Setter Property="Text" Value="重连中" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State, ElementName=root}" Value="Disconnected">
                            <Setter Property="Text" Value="已断开" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State, ElementName=root}" Value="Failed">
                            <Setter Property="Text" Value="失败" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State, ElementName=root}" Value="Idle">
                            <Setter Property="Text" Value="未连接" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Border>
</UserControl>
